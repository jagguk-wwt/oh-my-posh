{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#000000",
          "foreground": "#00FF00",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "trailing_diamond": "\ue0b0",
          "type": "session"
        },
        {
          "background": "#0a0a0a",
          "foreground": "#00FF00",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "folder_icon": "\uf07c",
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "\uf015",
            "style": "full"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#001a00",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#003300{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#004400{{ end }}",
            "{{ if gt .Ahead 0 }}#002200{{ end }}",
            "{{ if gt .Behind 0 }}#002200{{ end }}"
          ],
          "foreground": "#00FF00",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "go"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "ruby"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue77f {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "dotnet"
        },
        {
          "background": "#000000",
          "foreground": "#00FF00",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "threshold": 500
          },
          "style": "powerline",
          "template": " \uf252 {{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "background": "#000000",
          "background_templates": [
            "{{ if gt .Code 0 }}#330000{{ end }}"
          ],
          "foreground": "#00FF00",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF0000{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "properties": {
            "always_enabled": true
          },
          "style": "powerline",
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf00c{{ end }} ",
          "type": "status"
        },
        {
          "background": "#001a00",
          "foreground": "#00FF00",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "time_format": "15:04:05"
          },
          "style": "powerline",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "aws"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf0e7 {{ .EnvironmentName }} ",
          "trailing_diamond": "\ue0b4",
          "type": "az"
        },
        {
          "background": "#000000",
          "foreground": "#00AA00",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \ufd31 {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "kubectl"
        }
      ],
      "type": "rprompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#00FF00",
          "style": "plain",
          "template": "\u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 2
}
