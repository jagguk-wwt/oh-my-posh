{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#00FF00",
          "background": "#000000",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#00FF00",
          "background": "#000000",
          "properties": {
            "style": "full"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#00FF00",
          "background": "#000000",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "[{{ .HEAD }}{{ if .Working.Changed }} *{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }}] "
        },
        {
          "type": "exit",
          "style": "plain",
          "foreground": "#00FF00",
          "background": "#000000",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if gt .Code 0 }}[{{ .Code }}] {{ end }}$ "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#00FF00",
          "background": "#000000",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "[{{ .CurrentDate | date .Format }}]"
        }
      ]
    }
  ]
}
